{% extends 'base.html.twig' %}

{% block title %}Product index{% endblock %}

{% block body %}

        <div class="d-flex  justify-content-between py-3">
            <h5>Mes produits</h5>
            <a href="{{ path('app_product_new') }}" class="btn-beige">
                Créer un nouveau produit
            </a>
        </div>

        <div class="d-flex flex-wrap gap-2 py-3">
            {% for product in products %}
                <div class="card  rounded-4 bg-light-theme" style="width: 17rem;">
                    {% if product.imageFileName %}
                        <img src="{{ asset('uploads/products/' ~ product.imageFileName) }}"
                             class="card-img-top rounded-3" alt="illustration du produit" ,
                             style="width: 100%; height: 200px; object-fit: cover;">
                    {% else %}
                        <img src="{{ asset('images/default-product.png') }}" class="card-img-top"
                             alt="image par défaut">
                    {% endif %}
                    <div class="card-body">
                        <h5 class="card-title">{{ product.title }}</h5>
                        <p class="card-text">{{ product.price }}€ {{ product.unit }}</p>
                        <a href="{{ path('app_product_show', {'id': product.id}) }}" class=" btn-green">Voir le
                            produit</a>
                    </div>
                </div>
            {% else %}
                <p>Vous n'avez pas encore de produit.</p>
            {% endfor %}
        </div>

{% endblock %}
