{% extends 'base.html.twig' %}

{% block title %}Ajouter à un créneau{% endblock %}

{% block body %}
    <div class="w-75 mx-auto">
        <div class="d-flex justify-content-between py-3">
            <h5>
                Ajouter {{ product.title }} à un créneau
            </h5>
            <a href="{{ path('app_product_show', {'id': product.id}) }}" class="btn-beige">Annuler</a>
        </div>

        {{ form_start(form) }}
        {{ form_row(form.sellSlot) }}
        <button type="submit" class="btn-beige">Ajouter</button>
        {{ form_end(form) }}
    </div>
{% endblock %}
