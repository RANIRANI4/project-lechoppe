{% extends 'base.html.twig' %}

{% block title %}Créer mon compte{% endblock %}

{% block body %}

    <div class=" w-75 mx-auto">
        <div class="d-flex justify-content-between gap-3 py-3">

            <h5>
                Création de mon compte
            </h5>
            <a href="{{ path('app_login') }}" class="btn-beige">
                J'ai déjà un compte
            </a>
        </div>

        {{ form_start(registrationForm, {
            attr:{
                class: 'bg-light-theme py-3 px-3'
            }
        }) }}

        {{ form_row(registrationForm.firstName) }}
        {{ form_row(registrationForm.lastName) }}
        {{ form_row(registrationForm.email) }}
        {{ form_row(registrationForm.plainPassword) }}

        <button type="submit" class="btn-green">Créer mon compte</button>
        {{ form_end(registrationForm) }}

    </div>

{% endblock %}
