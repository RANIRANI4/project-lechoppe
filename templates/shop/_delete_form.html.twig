<form method="post" action="{{ path('app_shop_delete', {'id': shop.id}) }}"
      onsubmit="return confirm('Etes vous sûr de vouloir supprimer cette échoppe ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ shop.id) }}">
    <button class="btn-my-danger">Supprimer</button>
</form>
