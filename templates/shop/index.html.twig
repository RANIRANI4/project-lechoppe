{% extends 'base.html.twig' %}

{% block title %}Shop index{% endblock %}

{% block body %}
    <h1>Shop index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>ImageFileName</th>
                <th>Name</th>
                <th>Address</th>
                <th>ZipCode</th>
                <th>City</th>
                <th>Description</th>
                <th>CreatedAt</th>
                <th>UpdatedAt</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for shop in shops %}
            <tr>
                <td>{{ shop.id }}</td>
                <td>{{ shop.imageFileName }}</td>
                <td>{{ shop.name }}</td>
                <td>{{ shop.address }}</td>
                <td>{{ shop.zipCode }}</td>
                <td>{{ shop.city }}</td>
                <td>{{ shop.description }}</td>
                <td>{{ shop.createdAt ? shop.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ shop.updatedAt ? shop.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('app_shop_show', {'id': shop.id}) }}">show</a>
                    <a href="{{ path('app_shop_edit', {'id': shop.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="10">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_shop_new') }}">Create new</a>
{% endblock %}
