{% extends 'base.html.twig' %}

{% block title %}Shop{% endblock %}
{% block body %}
    <div class="container py-3">
        <div class="row">

            <div class="col-12 col-md-5">
                {% if shop.imageFileName %}
                    <img src="{{ asset('uploads/shops/' ~ shop.imageFileName) }}"
                         class="img-fluid rounded-3" alt="illustration de l'échoppe"
                         style="height: 300px; object-fit: cover; width: 100%;">
                {% else %}
                    <img src="{{ asset('images/default-shop.png') }}"
                         class="img-fluid rounded-3" alt="image par défaut">
                {% endif %}
            </div>

            <div class="col-12 col-md-7 ps-md-4">
                <h2>{{ shop.name }}</h2>
                <h4>{{ shop.address }}</h4>
                <p>{{ shop.description }}</p>

                {% if app.user and app.user == shop.producer %}

                    <div class="d-flex gap-3 py-3">
                        <a href="{{ path('app_shop_edit', {'id': shop.id}) }}" class="btn-beige">
                            Modifier l'échoppe
                        </a>
                        {{ include('shop/_delete_form.html.twig') }}
                    </div>
                {% endif %}

            </div>

        </div>
        <h5>Mes ventes à venir</h5>
    </div>

{% endblock %}
