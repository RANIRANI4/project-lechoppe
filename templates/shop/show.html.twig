{% extends 'base.html.twig' %}

{% block title %}Shop{% endblock %}

{% block body %}
    <h1>Shop</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ shop.id }}</td>
            </tr>
            <tr>
                <th>ImageFileName</th>
                <td>{{ shop.imageFileName }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ shop.name }}</td>
            </tr>
            <tr>
                <th>Address</th>
                <td>{{ shop.address }}</td>
            </tr>
            <tr>
                <th>ZipCode</th>
                <td>{{ shop.zipCode }}</td>
            </tr>
            <tr>
                <th>City</th>
                <td>{{ shop.city }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ shop.description }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ shop.createdAt ? shop.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>UpdatedAt</th>
                <td>{{ shop.updatedAt ? shop.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_shop_index') }}">back to list</a>

    <a href="{{ path('app_shop_edit', {'id': shop.id}) }}">edit</a>

    {{ include('shop/_delete_form.html.twig') }}
{% endblock %}
