{% extends 'base.html.twig' %}

{% block title %}SellSlot index{% endblock %}

{% block body %}
    <h1>SellSlot index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>StartDate</th>
                <th>EndDate</th>
                <th>CreatedAt</th>
                <th>UpdatedAt</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for sell_slot in sell_slots %}
            <tr>
                <td>{{ sell_slot.id }}</td>
                <td>{{ sell_slot.startDate ? sell_slot.startDate|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ sell_slot.endDate ? sell_slot.endDate|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ sell_slot.createdAt ? sell_slot.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ sell_slot.updatedAt ? sell_slot.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('app_sell_slot_show', {'id': sell_slot.id}) }}">show</a>
                    <a href="{{ path('app_sell_slot_edit', {'id': sell_slot.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_sell_slot_new') }}">Create new</a>
{% endblock %}
