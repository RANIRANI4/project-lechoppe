{% extends 'base.html.twig' %}

{% block title %}Détails du créneau{% endblock %}

{% block body %}

    <div class="container py-3 pb-5 mb-5">

        <div class="d-flex flex-column flex-md-row justify-content-md-between align-items-md-center gap-3 py-3">
            <h5 class="mb-0">
                Vente du {{ sell_slot.startDate ? sell_slot.startDate|date('d-m-y') : '' }} à {{ sell_slot.shop.name }}
            </h5>

            {% if app.user and app.user == sell_slot.shop.producer %}

                <div class="d-flex flex-column flex-md-row gap-2">
                    <a href="{{ path('app_sell_slot_add_product', {'id': sell_slot.id}) }}" class="btn-beige">
                        Ajouter un produit
                    </a>
                    <div class="d-flex gap-2">
                        <a href="{{ path('app_sell_slot_edit', {'id': sell_slot.id}) }}" class="btn-beige flex-grow-1">
                            Modifier
                        </a>
                        {{ include('sell_slot/_delete_form.html.twig') }}
                    </div>
                </div>
            {% endif %}

        </div>

        <div class="row g-3 py-3">
            {% for product in sell_slot.products %}
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card rounded-4 bg-light-theme border-0 h-100">
                        {% if product.imageFileName %}
                            <img src="{{ asset('uploads/products/' ~ product.imageFileName) }}"
                                 class="card-img-top rounded-3" alt="illustration du produit"
                                 style="width: 100%; height: 200px; object-fit: cover;">
                        {% else %}
                            <img src="{{ asset('images/default-product.png') }}" class="card-img-top"
                                 alt="image par défaut">
                        {% endif %}
                        <div class="card-body">
                            <h5 class="card-title">{{ product.title }}</h5>
                            <p class="card-text">{{ product.price }}€ {{ product.unit }}</p>
                            <a href="{{ path('app_product_show', {'id': product.id}) }}" class="btn-green">
                                Voir le produit
                            </a>
                        </div>
                    </div>
                </div>
            {% else %}
                <p>Aucun produit dans ce créneau.</p>
            {% endfor %}
        </div>

    </div>

{% endblock %}
