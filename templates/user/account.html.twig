{% extends 'base.html.twig' %}

{% block title %}Create user{% endblock %}


{% block body %}
    <h5>Mon compte</h5>

    <div>

        <div class="card bg-light-theme rounded-4" style=" width: 18rem;">
            <div class="card-body">
                <h5 class="card-title">{{ user.firstName }} {{ user.lastName }}</h5>
                <h6 class="card-subtitle mb-2 text-body-secondary">{{ user.email }}</h6>
            </div>
        </div>

    </div>
    <div class="py-5">
        <div class="d-flex  justify-content-between py-3">
            <h5>Mes échoppes</h5>
            <a href="{{ path('app_shop_new') }}" class="btn-beige">
                Créer une nouvelle échoppe
            </a>
        </div>

        <div class="d-flex flex-wrap gap-2 py-3">
            {% for shop in user.getShops %}
                <div class="card  rounded-4 bg-light-theme" style="width: 17rem;">
                    {% if shop.imageFileName %}
                        <img src="{{ asset('uploads/shops/' ~ shop.imageFileName) }}"
                             class="card-img-top rounded-3" alt="illustration de l'échoppe" ,
                             style="width: 100%; height: 200px; object-fit: cover;">
                    {% else %}
                        <img src="{{ asset('images/default-shop.png') }}" class="card-img-top" alt="image par défaut">
                    {% endif %}
                    <div class="card-body">
                        <h5 class="card-title">{{ shop.name }}</h5>
                        <p class="card-text">{{ shop.address }}, {{ shop.zipCode }} {{ shop.city }}</p>
                        <a href="{{ path('app_shop_show', {'id': shop.id}) }}" class=" btn-green">Voir l'échoppe</a>
                    </div>
                </div>
            {% else %}
                <p>Vous n'avez pas encore d'échoppe.</p>
            {% endfor %}
        </div>
    </div>


{% endblock %}
