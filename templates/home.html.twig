{% extends 'base.html.twig' %}

{% block title %}Trouvez des producteurs locaux près de chez vous — L'Échoppe{% endblock %}
{% block body %}
    <div class="container mt-4">

        <form method="get" action="{{ path('app_home') }}">
            <div class="d-flex gap-2 mb-4">
                <input
                    type="text"
                    name="location"
                    value="{{ location }}"
                    placeholder="Ville ou code postal..."
                    class="form-control"
                >
                <button type="submit" class="btn-green">
                    Rechercher
                </button>
            </div>
        </form>

        {% if location %}
            {% if shops %}
                <p>{{ shops|length }} échoppe(s) trouvée(s) près de "{{ location }}"</p>
            {% else %}
                <p>Aucune échoppe trouvée près de "{{ location }}".</p>
            {% endif %}
        {% endif %}

        {% if shops %}
            <div class="row g-4">
                {% for shop in shops %}
                    <div class="col-12 col-md-6 col-lg-4">
                        <div class="card h-100 border-0 rounded-4 p-3" style="background-color: #F3ECCE;">

                            {# Image + infos #}
                            <div class="d-flex gap-3 mb-3">
                                {% if shop.imageFileName %}
                                    <img
                                        src="{{ asset('uploads/shops/' ~ shop.imageFileName) }}"
                                        alt="{{ shop.name }}"
                                        class="rounded-3 object-fit-cover"
                                        style="width: 110px; height: 110px;"
                                    >
                                {% endif %}
                                <div class="d-flex flex-column justify-content-center">
                                    <h6 class="mb-2">{{ shop.name }}</h6>
                                    <p class="mb-0 text-muted small">{{ shop.address }}</p>
                                    <p class="mb-0 text-muted small">{{ shop.zipCode }} {{ shop.city }}</p>
                                </div>
                            </div>

                            <hr class="my-2" style="border-color: #4F6F52;">
                            <div class="d-flex gap-2 mt-2">
                                <a href="{{ path('app_shop_show', {id: shop.id}) }}"
                                   class="btn-beige flex-fill text-center">
                                    Voir l'échoppe
                                </a>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

        {% if totalPages is not null and totalPages > 1 %}
            <nav aria-label="Pagination des échoppes" class="mt-4 mb-5 pb-4">
                <ul class="pagination justify-content-center">

                    <li class="page-item {{ currentPage <= 1 ? 'disabled' }}">
                        <a class="page-link" href="{{ path('app_home', {page: currentPage - 1}) }}">
                            Précédent
                        </a>
                    </li>

                    {% for i in 1..totalPages %}
                        <li class="page-item {{ i == currentPage ? 'active' }}">
                            <a class="page-link" href="{{ path('app_home', {page: i}) }}">
                                {{ i }}
                            </a>
                        </li>
                    {% endfor %}

                    <li class="page-item {{ currentPage >= totalPages ? 'disabled' }}">
                        <a class="page-link" href="{{ path('app_home', {page: currentPage + 1}) }}">
                            Suivant
                        </a>
                    </li>

                </ul>
            </nav>
        {% endif %}
    </div>
{% endblock %}
