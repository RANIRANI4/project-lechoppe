<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>{% block title %}L'Échoppe{% endblock %}</title>
    <meta name="description" content="{% block meta_description %}
    L'Échoppe met en relation directe producteurs locaux et consommateurs.
    Trouvez les producteurs près de chez vous, commandez en ligne, retirez sur place.
{% endblock %}">
    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}

    {% block javascripts %}
        {{ encore_entry_script_tags('app') }}
    {% endblock %}
</head>
<body>

{% if not app.user %}

    {% include 'partials/_navbar.html.twig' %}
    {% include 'partials/_navbar-mobile.html.twig' %}


{% elseif is_granted('ROLE_USER') %}

    {% include 'partials/_user-navbar-mobile.html.twig' %}
    {% include 'partials/_user-navbar.html.twig' %}

{% endif %}


<main class="container py-4">

    {% block body %}{% endblock %}

</main>

</body>
</html>
